# CiteCCA Staging Deployment Environment Variables
# Copy to .env and fill in values — never commit .env

# Staging LXC / Proxmox
CONTAINER_ID=1001
DEPLOY_DIR=/opt/citecca-website

# Container setup (setup-lxc.sh)
LXC_HOSTNAME=citecca-website
LXC_IP=192.168.1.200
LXC_GATEWAY=192.168.1.1
LXC_BRIDGE=vmbr0
LXC_ROOTFS_STORAGE=local-lvm
LXC_ROOTFS_SIZE=20
LXC_MEMORY=2048
LXC_CORES=2
LXC_PASSWORD=<generate_strong_password>

# Deployment health check
HEALTH_CHECK_URL=http://192.168.1.200/
HEALTH_CHECK_TIMEOUT=30

# App server
PORT=3000

# ─── Docker Configuration ─────────────────────────────────────────
# Registry URL (e.g., https://index.docker.io/v1/)
DOCKER_REGISTRY=

# Registry credentials (leave empty to skip login)
DOCKER_REGISTRY_USER=
DOCKER_REGISTRY_PASS=

# Image name and tag
DOCKER_IMAGE_NAME=citecca-website
DOCKER_IMAGE_TAG=latest

# Set to true to skip Docker build (deploy only to LXC)
SKIP_DOCKER=false
